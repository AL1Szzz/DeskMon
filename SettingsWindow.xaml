<Window x:Class="DeskMon.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMon 显示选项" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource CheckOption}"/>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="14"
            BorderBrush="#26FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,13,12,11" MouseLeftButtonDown="TitleBar_MouseDown"
                    Background="Transparent" CornerRadius="14,14,0,0">
                <Grid>
                    <TextBlock Text="显示选项" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                    <Button Content="✕" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,4,18,14">

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="显示项目" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                        <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkCpuLoad" Content="占用" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkCpuTemp" Content="温度" Margin="0,0,0,14"/>

                        <TextBlock Text="显卡" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkGpuLoad" Content="占用" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkGpuTemp" Content="温度" Margin="0,0,0,14"/>

                        <TextBlock Text="其他" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkFan" Content="显卡转速" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkRam" Content="内存" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkVram" Content="显存" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkNet" Content="网络"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CkPill" Content="半透明底衬"/>
                    </StackPanel>
                </Border>

                <Button Content="完成" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Padding="20,7" Click="Done_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
