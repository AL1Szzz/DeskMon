<Window x:Class="DeskMon.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMon 显示选项" Width="240" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF1F242E" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <!-- default check glyph inherits the OS theme color (dark on this dark window it
             was invisible). draw an explicit white tick so IsChecked is always visible. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator VerticalAlignment="Center">
                            <BulletDecorator.Bullet>
                                <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                        BorderBrush="#8CFFFFFF" BorderThickness="1"
                                        Background="#FF2A3038">
                                    <Path x:Name="Tick" Data="M1.5,7 L5.5,10.5 L11,2.5"
                                          Stroke="#FFFFFFFF" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" Margin="2.5" Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF3E6BE6"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF3E6BE6"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,12,18,14">
        <TextBlock Text="CPU" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,2"/>
        <CheckBox x:Name="CkCpuLoad" Content="占用" Margin="4,2,0,0"/>
        <CheckBox x:Name="CkCpuTemp" Content="温度" Margin="4,2,0,0"/>
        <TextBlock Text="显卡" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,10,0,2"/>
        <CheckBox x:Name="CkGpuLoad" Content="占用" Margin="4,2,0,0"/>
        <CheckBox x:Name="CkGpuTemp" Content="温度" Margin="4,2,0,0"/>
        <CheckBox x:Name="CkFan" Content="显卡转速" Margin="0,10,0,0"/>
        <CheckBox x:Name="CkRam" Content="内存" Margin="0,6,0,0"/>
        <CheckBox x:Name="CkVram" Content="显存" Margin="0,6,0,0"/>
        <CheckBox x:Name="CkNet" Content="网络" Margin="0,6,0,0"/>
        <CheckBox x:Name="CkPill" Content="半透明底衬" Margin="0,10,0,0"/>
        <Button Content="完成" Margin="0,14,0,0" Click="Done_Click"
                HorizontalAlignment="Right" Padding="16,4"/>
    </StackPanel>
</Window>
